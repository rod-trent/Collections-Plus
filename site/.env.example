# Copy to .env.local for local dev; set the same names in Vercel → Settings →
# Environment Variables for production. Leave both empty and the site runs with
# accounts closed (the landing page and mobile app don't need them).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Where Clerk sends people to sign in / sign up (pages in this app).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Plus Sync storage: Neon Postgres. Vercel's Neon integration (Storage → Neon)
# sets this for you; `vercel env pull .env.local` brings it down for local dev
# and for `npm run db:setup`. Without it /api/sync answers 503.
DATABASE_URL=

# Complimentary/admin access: Clerk user IDs (user_…), separated by commas, who
# get Plus Sync without paying. They can also test checkout before launch.
# Everyone else needs a subscription, or gets 403.
PLUS_SYNC_ALLOWED_USER_IDS=

# Billing (Stripe). Leave the key or price empty and billing stays hidden.
# Setup: ../docs/plus-sync-billing-setup.md. Use sk_test_… keys until launch.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Launch switch: 1 opens Subscribe to everyone. Anything else: allowlist only.
PLUS_SYNC_ON_SALE=
# The price as shown on the site (defaults: $20, per year). Match the Stripe Price.
PLUS_SYNC_PRICE_AMOUNT=
PLUS_SYNC_PRICE_PERIOD=

# Optional: image storage cap per user, in MB (default 250).
PLUS_SYNC_QUOTA_MB=
